<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Carbonix.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;NU1605</NoWarn>
    <DebugType>portable</DebugType>
    <outputPath>..\..\bin\Debug\net461\plugins\</outputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1701;1702;NU1605</NoWarn>
    <DebugType>portable</DebugType>
    <outputPath>..\..\bin\Release\net461\plugins\</outputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="ConfigFiles\checklistO1.xml" />
    <None Remove="ConfigFiles\checklistV1.xml" />
    <None Remove="ConfigFiles\joystickaxisArduPlane.xml" />
    <None Remove="ConfigFiles\joystickbuttonsArduPlane.xml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ConfigFiles\checklistO1.xml" />
    <EmbeddedResource Include="ConfigFiles\checklistV1.xml" />
    <EmbeddedResource Include="ConfigFiles\joystickaxisArduPlane.xml" />
    <EmbeddedResource Include="ConfigFiles\joystickbuttonsArduPlane.xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ExtLibs\MissionPlanner.Drawing\MissionPlanner.Drawing.csproj">
      <Aliases>Drawing</Aliases>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\ExtLibs\Maps\MissionPlanner.Maps.csproj">
      <!-- Maps multi-targets net472;netstandard2.0. Pin the TFM so command-line
           MSBuild resolves the reference (VS resolves it implicitly). -->
      <SetTargetFramework>TargetFramework=net472</SetTargetFramework>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\ExtLibs\Utilities\MissionPlanner.Utilities.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\MissionPlanner.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\ExtLibs\LEDBulb\Bulb\Bulb.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- Direct DLL references for assemblies already present in the MissionPlanner output.
       Private=false so they are not copied to the plugin output; MP already loads them. -->
  <ItemGroup>
    <Reference Include="ZedGraph">
      <HintPath>..\..\bin\$(Configuration)\net461\ZedGraph.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SharpKml">
      <HintPath>..\..\bin\$(Configuration)\net461\SharpKml.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DotSpatial.Data">
      <HintPath>..\..\bin\$(Configuration)\net461\DotSpatial.Data.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DotSpatial.Projections">
      <HintPath>..\..\bin\$(Configuration)\net461\DotSpatial.Projections.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Reference Update="System.Windows.Forms">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Resources\" />
  </ItemGroup>

</Project>